# Agent-Vorcl-Flow — единый файл секретов для MCP-серверов.
#
# Скопируй в ~/.config/agent-vorcl-flow/.env (на Windows — %APPDATA%\agent-vorcl-flow\.env)
# и впиши только те ключи, которыми пользуешься. Пустые/отсутствующие серверы
# просто не поднимаются — остальные работают.
#
#   cp .env.example ~/.config/agent-vorcl-flow/.env
#   chmod 600 ~/.config/agent-vorcl-flow/.env
#
# Этот файл читает launcher bin/mcp-env.mjs ОДИНАКОВО для Claude Code, Codex,
# Cursor и Kimi CLI — и при запуске из терминала, и из Dock/Spotlight/IDE.
# Поэтому ~/.zshrc для секретов больше не нужен.
#
# Приоритет: этот файл  <  ./.env в корне проекта  <  реальный export в окружении.

# ── Task Master (выбери хотя бы один main-provider) ──
ANTHROPIC_API_KEY=          # Claude — main provider для parse_prd / expand
OPENAI_API_KEY=             # GPT — альтернатива Claude
PERPLEXITY_API_KEY=         # опционально: research-режим Task Master

# ── Веб-ресёрч ──
FIRECRAWL_API_KEY=          # firecrawl: search / scrape / crawl / extract  (fc-...)

# ── GitHub ──
GITHUB_TOKEN=               # github MCP (personal access token, classic или fine-grained)

# ── Базы данных проекта (агент database) ──
MONGODB_URI=                # mongodb://user:pass@host:27017/db
REDIS_URL=                  # redis://host:6379
POSTGRES_URL=               # postgres://user:pass@host:5432/db

# Vercel и Render — БЕЗ ключей: авторизация по OAuth в браузере при первом вызове
# (в headless/CI для Render можно задать RENDER_API_KEY и использовать Bearer-заголовок).

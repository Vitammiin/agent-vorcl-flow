# No environment file is needed for roles/skills or the installer.
# Configure MCP connectors and Task Master in your own client; AVF does not
# install servers, copy credentials, or choose their providers/models.
#
# Optional experimental runtime only. Nothing loads this file automatically.
# To use a file explicitly, set AGENT_VORCL_ENV_FILE to its absolute path.
# Existing process environment wins. Do not commit populated credentials.
#
# AVF_RUNTIME_PORT=19790
# AVF_ALLOWED_ROOTS=/absolute/path/to/workspace
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# AVF_OPENAI_MODEL=
# AVF_ANTHROPIC_MODEL=

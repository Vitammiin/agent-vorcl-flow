{
  "schemaVersion": 2,
  "defaults": {
    "executionMode": [
      "external",
      "autonomous"
    ],
    "permissions": [
      "read",
      "workspace_write"
    ],
    "inputContract": "ExecutionEnvelope@1",
    "outputContract": "ToolReceipt@1",
    "checker": "testing",
    "testStrategy": "Run the task testStrategy and record an independent READY or NOT_READY receipt before completion."

        "workspace-capability-routing",
        "system-design",
        "database",
        "api-design",
        "i18n",
        "web-scraping",
        "vercel",
        "render"
      ],
      "readonly": false
    },
    {
      "id": "principal-architect",
      "route": "complete multi-language current architecture package",
      "owns": "MD/JSON/HTML/PDF/draw.io/Mermaid package",
      "notFor": "lightweight TS/JS dependency map",
      "skillHints": [
        "principal-architecture",
        "system-design",
        "database",
        "api-design",
        "backend-architecture",
        "error-handling",
        "security-audit",

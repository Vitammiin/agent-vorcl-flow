{
  "name": "agent-vorcl-flow",
  "version": "2.3.1",
  "description": "Agent-Vorcl-Flow для Claude Code, GPT Codex, Cursor и Kimi CLI: роли, skills, команды, MCP и эфемерное локальное live-табло.",
  "bin": {
    "agent-vorcl-flow": "bin/install.mjs"
  },
  "scripts": {
    "test": "node scripts/readme-locales.mjs --check && node --test skills/design-studio/agents/tests/*.test.mjs skills/expo-mobile-architecture/tests/*.test.mjs skills/expo-ui-design-motion/tests/*.test.mjs skills/project-audit/tests/*.test.mjs skills/principal-architecture/tests/*.test.mjs",
    "docs:locales": "node scripts/readme-locales.mjs --check",
    "docs:locales:generate": "node scripts/readme-locales.mjs --generate",
    "test:expo-architecture": "node --test skills/expo-mobile-architecture/tests/*.test.mjs",
    "test:expo-compatibility": "node --test skills/expo-mobile-architecture/tests/compatibility-preflight.test.mjs",
    "test:expo-ui": "node --test skills/expo-ui-design-motion/tests/*.test.mjs",
    "test:project-audit": "node --test skills/project-audit/tests/*.test.mjs",
    "test:design-studio": "node --test skills/design-studio/agents/tests/*.test.mjs",
    "test:principal-architecture": "node --test skills/principal-architecture/tests/*.test.mjs"
  },
  "files": [
    "bin/",
    "agents/",
    "skills/",
    "commands/",
    "hooks/",
    "scripts/",
    ".mcp.json",
    ".env.example",
    ".claude-plugin/",
    "codex/",
    "cursor/",
    "kimi/",
    "README.md",
    "translations/"
  ],
  "keywords": [
    "claude",
    "claude-code",
    "codex",
    "cursor",
    "kimi",
    "kimi-cli",
    "plugin",
    "agents",
    "subagents",
    "skills",
    "mcp",
    "task-master",
    "installer"
  ],
  "engines": {
    "node": ">=18"
  },
  "os": [
    "darwin",
    "linux",
    "win32"
  ],
  "license": "MIT",
  "author": "Christian Avis (https://github.com/Vitammiin)",
  "contributors": [
    "Vorcl"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Vitammiin/agent-vorcl-flow.git"
  },
  "homepage": "https://github.com/Vitammiin/agent-vorcl-flow#readme",
  "bugs": {
    "url": "https://github.com/Vitammiin/agent-vorcl-flow/issues"
  },
  "publishConfig": {
    "access": "public"
  }
}

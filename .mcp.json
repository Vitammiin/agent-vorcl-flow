{
  "mcpServers": {
    "github": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--need=GITHUB_PERSONAL_ACCESS_TOKEN",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-github"
      ]
    },
    "filesystem": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-filesystem",
        "${CLAUDE_PROJECT_DIR}"
      ]
    },
    "postgres": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--need=POSTGRES_URL",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-postgres",
        "%%POSTGRES_URL%%"
      ]
    },
    "mongodb": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--need=MDB_MCP_CONNECTION_STRING",
        "--",
        "npx",
        "-y",
        "mongodb-mcp-server@latest"
      ]
    },
    "redis": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--need=REDIS_URL",
        "--",
        "npx",
        "-y",
        "@modelcontextprotocol/server-redis",
        "%%REDIS_URL%%"
      ]
    },
    "docker": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--",
        "npx",
        "-y",
        "mcp-server-docker"
      ]
    },
    "firecrawl": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--need=FIRECRAWL_API_KEY",
        "--",
        "npx",
        "-y",
        "firecrawl-mcp"
      ]
    },
    "vercel": {
      "type": "http",
      "url": "https://mcp.vercel.com"
    },
    "render": {
      "type": "http",
      "url": "https://mcp.render.com/mcp"
    },
    "task-master": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--",
        "npx",
        "-y",
        "task-master-ai"
      ],
      "env": {
        "TASK_MASTER_TOOLS": "parse_prd,get_tasks,get_task,next_task,expand_task,set_task_status,update_subtask,add_task,analyze_project_complexity,models"
      }
    },
    "mermaid": {
      "command": "node",
      "args": [
        "${CLAUDE_PLUGIN_ROOT}/bin/mcp-env.mjs",
        "--",
        "npx",
        "-y",
        "mcp-mermaid"
      ]
    }
  }
}

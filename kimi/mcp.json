{
  "mcpServers": {
    "github": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--need=GITHUB_PERSONAL_ACCESS_TOKEN", "--", "npx", "-y", "@modelcontextprotocol/server-github"]
    },
    "filesystem": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--", "npx", "-y", "@modelcontextprotocol/server-filesystem", "."]
    },
    "postgres": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--need=POSTGRES_URL", "--", "npx", "-y", "@modelcontextprotocol/server-postgres", "%%POSTGRES_URL%%"]
    },
    "mongodb": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--need=MDB_MCP_CONNECTION_STRING", "--", "npx", "-y", "mongodb-mcp-server@latest"]
    },
    "redis": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--need=REDIS_URL", "--", "npx", "-y", "@modelcontextprotocol/server-redis", "%%REDIS_URL%%"]
    },
    "docker": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--", "npx", "-y", "mcp-server-docker"]
    },
    "firecrawl": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--need=FIRECRAWL_API_KEY", "--", "npx", "-y", "firecrawl-mcp"]
    },
    "vercel": {
      "url": "https://mcp.vercel.com",
      "transport": "http"
    },
    "render": {
      "url": "https://mcp.render.com/mcp",
      "transport": "http"
    },
    "task-master": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--", "npx", "-y", "task-master-ai"],
      "env": {
        "TASK_MASTER_TOOLS": "parse_prd,get_tasks,get_task,next_task,expand_task,set_task_status,update_subtask,add_task,analyze_project_complexity,models"
      }
    },
    "mermaid": {
      "command": "node",
      "args": ["__AVF_LAUNCHER__", "--", "npx", "-y", "mcp-mermaid"]
    }
  }
}
